<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template id="report_property_detail">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <!-- <t t-call="report.external_layout"> -->
                <div class="page">
                    <t t-set="property" t-value="property_data[0]"/>

                    <h2 class="text-center">
                        <strong>Name:</strong>
                        <t t-if="property.get('name')">
                            <span t-esc="property.get('name')"/>
                        </t>
                    </h2>

                    <div class="container text-center">
                    <div class="row">
                        <div class="col-3 text-start">
                            <t t-if="property.get('property_type')">
                                <strong>Property Type:</strong>
                                <br/>
                                 <span t-esc="property.get('property_type')"/>
                            </t>
                        </div>
                        <div class="col-3 text-start">
                            <t t-if="property.get('best_offer')">
                                <strong>Best offer:</strong>
                                <br/>
                                 <span t-esc="property.get('best_offer')"/>
                            </t>
                        </div>
                    </div>
                    </div>


                    <!--
                    Build your report here!
                    Do it in awesome way ;)
                    -->
                </div>
            </t>
        </t>
    </template>


</odoo>