    <!--From This code we add the menu inside the home portal-->
    <template id="portal_my_home_menu_recruitment" name="Recruitment" inherit_id="portal.portal_my_home"
              customize_show="True" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/project/static/src/img/folder.svg'"/>
                <t t-set="title">Homes</t>
                <t t-set="url" t-value="'/realestate/'"/>
                <t t-set="text">View the Homes</t>
                <t t-set="placeholder_count" t-value="'count'"/>
            </t>
        </xpath>
    </template>


    <!--This code is for Table-->
    <template id="portal_my_estate_property" name="My Homes">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Homes</t>
            </t>
            <t t-if="not propertys">
                <p class="alert alert-warning">There are currently no Homes .</p>
            </t>
            <t t-if="propertys" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th name="house">House</th>
                        <th name="house">Property Type</th>
                        <th name="post_code">Post Code</th>
                        <th name="date_availability" class='d-none d-md-table-cell'>Date Availability</th>
                        <th name="expected_price">Expected Price</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="propertys" t-as="propertys">
                        <tr>
                            <td>
                                <!--This convert the House Name into the URL-->
                                <a t-attf-href="/realestate/property/{{ slug(propertys) }}">
                                    <t t-esc="propertys.name"/>
                                </a>
                            </td>
                            <td>
                                <span t-field="propertys.property_type_id"/>
                            </td>
                            <td>
                                <span t-field="propertys.postcode"/>
                            </td>
                            <td class='d-none d-md-table-cell'>
                                <span t-field="propertys.date_availability"/>
                            </td>
                            <td>
                                <span t-field="propertys.expected_price"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>


    <!--here i want to show the bread crumbs-->
     <template id="portal_recruitment_home" name="homes" inherit_id="portal.portal_breadcrumbs" priority="30">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li
                t-attf-class="breadcrumb-item #{'active ' if not estate_property else ''}">
                <a t-attf-href="/realestate?{{ keep_query() }}">Houses</a>
            </li>
        </xpath>
    </template>

