    <!--From This code we add the menu inside the home portal main page-->
    <template id="portal_my_home_menu_recruitment" name="Recruitment" inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <div class="col-md-6 o_portal_doc">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/project/static/src/img/folder.svg'"/>
                    <t t-set="title">Homes</t>
                    <t t-set="url" t-value="'/realestate/'"/>
                    <t t-set="text">View the Homes</t>
                    <t t-set="show_count" t-value="True"/>
                    <t t-set="placeholder_count" t-value="'realestate_count'"/>
                </t>
            </div>
        </xpath>
    </template>


