    <!--Here the Data will be displayed-->
    <template id="estate_property_detail" name="My Home">
        <t t-call="portal.portal_layout">
            <t t-set="o_portal_fullwidth_alert">
                <t t-call="portal.portal_back_in_edit_mode">
                    <t t-set="backend_url"
                       t-value="'/web#model=estate.property&amp;id=%s&amp;view_type=form' % (name.id)"/>
                </t>
            </t>
            <t t-call="portal.portal_record_layout">
                <t t-set="card_header">
                    <h3 class="mb-1 mb-md-0">
                        <small class="text_muted">Course -</small>
                        <span t-field="name.name"/>
                    </h3>
                </t>
                <t t-set="card_body">
                    <div class="o_sign_portal">
                        <h5>
                            <t t-esc="name.name"/>
                        </h5>
                        <li>
                            <t t-esc="name.state"/>
                        </li>
                        <li>
                            <span t-field="name.expected_price"/>
                        </li>
                        <li>
                            <t t-esc="name.postcode"/>
                        </li>
                        <li>
                            <t t-esc="name.date_availability"/>
                        </li>
                    </div>
                    <t t-if="name.offer_ids">
                        <t t-set="title">Offers</t>
                        <div class="container">
                            <t t-foreach="name.offer_ids" t-as="offer">
                                <li>
                                    <t t-esc="offer.price"/>
                                </li>
                            </t>
                        </div>
                    </t>
                </t>
            </t>
        </t>
    </template>







</odoo>