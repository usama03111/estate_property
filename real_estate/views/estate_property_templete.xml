    <!--This code is for Table-->
    <template id="portal_my_estate_property" name="My Homes">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Homes</t>
            </t>
            <t t-if="not propertys">
                <p class="alert alert-warning">There are currently no Homes .</p>
            </t>
            <t t-if="propertys" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th name="house">House</th>
                        <th name="house">Property Type</th>
                        <th name="post_code">Post Code</th>
                        <th name="date_availability" class='d-none d-md-table-cell'>Date Availability</th>
                        <th name="expected_price">Expected Price</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="propertys" t-as="propertys">
                        <tr>
                            <td>
                                <!--This convert the House Name into the URL-->
                                <a t-attf-href="/realestate/property/{{ slug(propertys) }}">
                                    <!--                                <a t-attf-href="/realestate/property">-->
                                    <t t-esc="propertys.name"/>
                                </a>
                            </td>
                            <td>
                                <span t-field="propertys.property_type_id"/>
                            </td>
                            <td>
                                <span t-field="propertys.postcode"/>
                            </td>
                            <td class='d-none d-md-table-cell'>
                                <span t-field="propertys.date_availability"/>
                            </td>
                            <td>
                                <span t-field="propertys.expected_price"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>


    <!--here i want to show the bread crumbs in the top mean url-->
    <template id="inherit_estate_property_detail_breadcrumbs" inherit_id="portal.portal_breadcrumbs"
              name="Estate Property Detail Breadcrumbs">
        <xpath expr="//ol[contains(@class, 'breadcrumb')]" position="inside">
            <li t-if="page_name == 'estate_property'" class="breadcrumb-item" aria-current="page">
                <span>Houses</span>
            </li>
            <li t-if="page_name == 'estate_property_detail'" class="breadcrumb-item" aria-current="page">
                <a href="/realestate">Houses</a>
            </li>
            <li t-if="page_name == 'estate_property_detail'" class="breadcrumb-item active" aria-current="page">
                <t t-esc="name.name"/>
            </li>
        </xpath>
    </template>


    <!--Here the Data will be displayed-->
    <template id="estate_property_detail" name="My Home">
        <t t-call="portal.portal_layout">
            <t t-set="o_portal_fullwidth_alert">
                <t t-call="portal.portal_back_in_edit_mode">
                    <t t-set="backend_url"
                       t-value="'/web#model=estate.property&amp;id=%s&amp;view_type=form' % (name.id)"/>
                </t>
            </t>
            <!--                <t t-set="card_header">-->
            <h3 class="mb-1 mb-md-0">
                <small class="text_muted">Course -</small>
                <span t-field="name.name"/>
            </h3>
            <!--                </t>-->
            <!--                <t t-set="card_body">-->
            <div class="o_sign_portal">
                <h5>
                    <t t-esc="name.name"/>
                </h5>
                <li>
                    <t t-esc="name.state"/>
                </li>
                <li>
                    <span t-field="name.expected_price"/>
                </li>
                <li>
                    <t t-esc="name.postcode"/>
                </li>
                <li>
                    <t t-esc="name.date_availability"/>
                </li>
            </div>
            <t t-if="name.offer_ids">
                <t t-set="title">Offers</t>
                <div class="container">
                    <t t-foreach="name.offer_ids" t-as="offer">
                        <li>
                            <t t-esc="offer.price"/>
                        </li>
                    </t>
                </div>
            </t>
            <!--                </t>-->
        </t>
    </template>


</odoo>