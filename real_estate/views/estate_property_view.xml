<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="estate_property_search_view" model="ir.ui.view">
        <field name="name">estate.property.search.view</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Estate">
                <field name="name" filter_domain="[('name','ilike' , self)]"/>
                <field name="state"/>
                <field name="postcode"/>
                <separator/>
                <group string="Filter">
                <filter name="filter_state_available" string="New Sold" domain="[('state' ,'in',( 'new','sold'))]"/>
                <filter name="filter_state_name" string="New" domain="[('state' , '=' , 'new')]"/>
                </group>
                <separator/>
                <group string="Group By">
                    <filter name="group_by_postcode" string="Postcode" context="{'group_by':'postcode'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="estate_property_tree_view" model="ir.ui.view">
        <field name="name">estate_property_tree_view</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <tree string="Estate Property">
                <field name="name"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_availability"/>
            </tree>
        </field>
    </record>

    <record id="estate_property_form_view" model="ir.ui.view">
        <field name="name">estate.property.view.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Estate Form">
                <header>
                    <button name="action_new" type="object" string="New" class="oe_highlight"
                            invisible="state != 'canceled'"/>
                    <button name="action_received" type="object" string="Received" class="oe_highlight"
                            invisible="state != 'new'"/>
                    <button name="action_accepted" type="object" string="Accepted" class="oe_highlight"
                            invisible="state != 'received'"/>
                    <button name="action_sold" type="object" string="Sold" class="oe_highlight"
                            invisible="state == 'sold'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="oe_highlight"
                            invisible="state not in ('new','received','accepted','sold')"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,received,accepted,sold,canceled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field':'color'}"/>
                        </group>
                        <br/>
                        <br/>
                        <group>
                            <field name="property_type_id"/>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="best_offer"/>
                            <field name="selling_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="description" string="Description">
                            <group>
                                <field name="description"/>
                                <field name="bedrooms"/>
                                <field name="living_area"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area"/>
                                <field name="garden_orientation" widget="radio"/>
                                <field name="total_area"/>
                            </group>
                        </page>
                        <page name="offers" string="Offers">
                            <field name="offer_ids">
                                <tree decoration-success="status == 'accepted'"
                                      decoration-danger="status == 'refused'" editable="bottom">
                                    <field name="price"/>
                                    <field name="partner_id"/>
                                    <field name="validity"/>
                                    <field name="date_deadline" column_invisible="parent.state == 'sold'"/>
                                    <button icon="fa-check" type="object" invisible="status in ('accepted','refused')"
                                            name="action_accept"/>
                                    <button icon="fa-times" type="object" invisible="status in ('accepted','refused')"
                                            name="action_refuse"/>
                                    <field name="status" optional="False"/>
                                </tree>
                            </field>
                        </page>
                        <page name="other_info" string="Other Info">
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Real Estate</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_state_available':True}</field>
    </record>


</odoo>